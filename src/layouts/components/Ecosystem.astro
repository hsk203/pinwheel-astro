---
// "Smart Home Communication Mode" — full-width, wide/short ecosystem diagram.
// Orthogonal (right-angle) dashed routing like the reference material.
// All devices from the source diagram are included. Zero dependencies.
---

<section class="section eco">
  <div class="container">
    <h2 class="eco-heading">Smart Home Communication Mode</h2>
  </div>

  <div class="container eco-wide">
    <div class="eco-figure">
      <svg viewBox="45 16 1120 636" role="img" aria-label="Smart home communication diagram: cloud, router and mobile phone outside the home; Wi-Fi branches to voice assistants and the Tuya platform gateways (Zigbee / BLE-mesh); Matter over Wi-Fi and Thread; a device bus connects wire-free switch, smart switches 1-4, thermostat, curtain motor, smart door lock, IR remote controller, camera, smoke alarm, motion sensor, door contact, control panel, plus fan, garage door and RF remote.">
        <!-- decorations -->
        <g>
          <circle cx="330" cy="120" r="3" fill="#F97316" opacity=".45"/>
          <circle cx="880" cy="130" r="3" fill="#22C55E" opacity=".45"/>
          <circle cx="60" cy="240" r="3" fill="#3B82F6" opacity=".4"/>
          <circle cx="1160" cy="240" r="3" fill="#F97316" opacity=".4"/>
          <circle cx="905" cy="580" r="3" fill="#22C55E" opacity=".4"/>
        </g>

        <!-- ============ orthogonal links ============ -->
        <g fill="none" stroke="rgba(249,115,22,.45)" stroke-width="1.6">
          <!-- cloud <-> mobile -->
          <path class="flow" d="M645 54 H1020"/>
          <!-- cloud -> router -->
          <path class="flow" d="M600 76 V146"/>
          <!-- router -> branch bus -->
          <path class="flow" d="M600 170 V215"/>
          <!-- branch bus -->
          <path class="flow" d="M180 215 H1020"/>
          <!-- branches down to boxes -->
          <path class="flow" d="M180 215 V265"/>
          <path class="flow" d="M1020 215 V265"/>
          <!-- branch drops to gateways -->
          <path class="flow" d="M490 215 V300"/>
          <path class="flow" d="M710 215 V300"/>
          <!-- voice box -> tuya zone -->
          <path class="flow" d="M300 325 H350"/>
          <!-- right box -> matter -> bus -->
          <path class="flow" d="M1020 400 V415"/>
          <path class="flow" d="M1020 455 V480"/>
          <!-- gateways -> device bus -->
          <path class="flow" d="M490 376 V480"/>
          <path class="flow" d="M710 376 V480"/>
          <!-- device bus -->
          <path class="flow" d="M70 480 H1130"/>
          <!-- bus -> sub bus (IR/RF appliances) -->
          <path class="flow" d="M655 480 V592"/>
          <path class="flow" d="M545 580 H765"/>
          <path class="flow" d="M560 580 V592"/>
          <path class="flow" d="M750 580 V592"/>
          <!-- device stubs -->
          <path class="flow" d="M100 480 V492"/>
          <path class="flow" d="M200 480 V492"/>
          <path class="flow" d="M300 480 V492"/>
          <path class="flow" d="M400 480 V492"/>
          <path class="flow" d="M500 480 V492"/>
          <path class="flow" d="M600 480 V492"/>
          <path class="flow" d="M700 480 V492"/>
          <path class="flow" d="M800 480 V492"/>
          <path class="flow" d="M900 480 V492"/>
          <path class="flow" d="M1000 480 V492"/>
          <path class="flow" d="M1100 480 V492"/>
        </g>

        <!-- ============ traveling packets ============ -->
        <g class="pkts">
          <circle class="pkt" r="3.2" fill="#F97316">
            <animateMotion dur="1.6s" repeatCount="indefinite" path="M600 76 L600 146"/>
          </circle>
          <circle class="pkt" r="3.2" fill="#FB923C">
            <animateMotion dur="2.6s" repeatCount="indefinite" path="M600 170 L600 215 L490 215 L490 300"/>
          </circle>
          <circle class="pkt" r="3" fill="#FBBF24">
            <animateMotion dur="2s" begin="0.9s" repeatCount="indefinite" path="M600 215 L710 215 L710 300"/>
          </circle>
          <circle class="pkt" r="3" fill="#FB923C">
            <animateMotion dur="3.4s" repeatCount="indefinite" path="M710 376 L710 480 L1020 480 L1020 456"/>
          </circle>
          <circle class="pkt" r="3" fill="#F97316">
            <animateMotion dur="3s" repeatCount="indefinite" path="M645 54 L1020 54"/>
          </circle>
        </g>

        <!-- ============ junction dots ============ -->
        <g>
          <circle cx="490" cy="215" r="3" fill="#F97316" opacity=".7"/>
          <circle cx="710" cy="215" r="3" fill="#F97316" opacity=".7"/>
          <circle cx="490" cy="480" r="3" fill="#F97316" opacity=".7"/>
          <circle cx="710" cy="480" r="3" fill="#F97316" opacity=".7"/>
          <circle cx="1020" cy="480" r="3" fill="#F97316" opacity=".7"/>
        </g>

        <!-- ============ cloud ============ -->
        <g class="float" style="animation-delay:0s">
          <path d="M583 76 q-20 0 -20 -17 q0 -15 15 -17 q5 -15 22 -15 q17 0 22 15 q15 2 15 17 q0 17 -20 17 z"
                fill="#fff" stroke="#F97316" stroke-width="2"/>
          <text x="600" y="97" text-anchor="middle" class="lbl halo">Cloud</text>
        </g>

        <!-- ============ mobile ============ -->
        <g class="float" style="animation-delay:.6s">
          <rect x="1024" y="26" width="32" height="56" rx="7" fill="#fff" stroke="#94A3B8" stroke-width="1.8"/>
          <line x1="1034" y1="74" x2="1046" y2="74" stroke="#94A3B8" stroke-width="1.8" stroke-linecap="round"/>
          <text x="1040" y="100" text-anchor="middle" class="lbl">Mobile Phone</text>
        </g>
        <text x="832" y="44" text-anchor="middle" class="note">Outside the home</text>

        <!-- ============ router ============ -->
        <g class="float" style="animation-delay:.3s">
          <line x1="578" y1="146" x2="572" y2="132" stroke="#94A3B8" stroke-width="2" stroke-linecap="round"/>
          <line x1="622" y1="146" x2="628" y2="132" stroke="#94A3B8" stroke-width="2" stroke-linecap="round"/>
          <rect x="558" y="146" width="84" height="24" rx="7" fill="#fff" stroke="#94A3B8" stroke-width="1.8"/>
          <circle cx="572" cy="158" r="2.4" fill="#F97316"/>
          <circle cx="583" cy="158" r="2.4" fill="#FBBF24"/>
          <circle cx="594" cy="158" r="2.4" fill="#22C55E"/>
          <text x="600" y="190" text-anchor="middle" class="lbl halo">Router</text>
        </g>

        <!-- wi-fi chips on the branch bus -->
        <g class="float" style="animation-delay:.9s">
          <rect x="358" y="205" width="44" height="20" rx="10" fill="#FFF7ED" stroke="#F97316" stroke-width="1.4"/>
          <text x="380" y="219" text-anchor="middle" class="chip-lbl">Wi-Fi</text>
        </g>
        <g class="float" style="animation-delay:1.5s">
          <rect x="798" y="205" width="44" height="20" rx="10" fill="#FFF7ED" stroke="#F97316" stroke-width="1.4"/>
          <text x="820" y="219" text-anchor="middle" class="chip-lbl">Wi-Fi</text>
        </g>

        <!-- ============ left box : voice control ============ -->
        <g>
          <rect x="60" y="265" width="240" height="120" rx="14" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <text x="180" y="290" text-anchor="middle" class="box-head">Voice Control</text>
          <circle cx="100" cy="317" r="11" fill="#F1F5F9" stroke="#CBD5E1" stroke-width="1.4"/>
          <circle cx="100" cy="317" r="4" fill="#94A3B8"/>
          <text x="122" y="322" class="row-lbl">Amazon Alexa</text>
          <circle cx="100" cy="355" r="11" fill="#F1F5F9" stroke="#CBD5E1" stroke-width="1.4"/>
          <circle cx="100" cy="355" r="4" fill="#94A3B8"/>
          <text x="122" y="360" class="row-lbl">Hey Google</text>
        </g>

        <!-- ============ right box : ecosystems ============ -->
        <g>
          <rect x="900" y="265" width="240" height="135" rx="14" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <circle cx="935" cy="295" r="11" fill="#F1F5F9" stroke="#CBD5E1" stroke-width="1.4"/>
          <circle cx="935" cy="295" r="4" fill="#94A3B8"/>
          <text x="957" y="300" class="row-lbl">Apple HomePod</text>
          <circle cx="935" cy="332" r="11" fill="#F1F5F9" stroke="#CBD5E1" stroke-width="1.4"/>
          <circle cx="935" cy="332" r="4" fill="#94A3B8"/>
          <text x="957" y="337" class="row-lbl">Amazon Echo</text>
          <circle cx="935" cy="369" r="11" fill="#F1F5F9" stroke="#CBD5E1" stroke-width="1.4"/>
          <circle cx="935" cy="369" r="4" fill="#94A3B8"/>
          <text x="957" y="374" class="row-lbl">Google Nest</text>
        </g>

        <!-- ============ tuya platform zone ============ -->
        <text x="605" y="257" text-anchor="middle" class="tuya-lbl halo">Tuya Platform Ready</text>
        <rect x="350" y="265" width="510" height="190" rx="18" fill="none"
              stroke="#F87171" stroke-width="1.6" stroke-dasharray="7 6"/>

        <!-- gateway 1 (main) -->
        <g class="float" style="animation-delay:.2s">
          <rect x="452" y="300" width="76" height="76" rx="16" fill="url(#hubGrad)" stroke="#EA580C" stroke-width="1.6"/>
          <rect x="472" y="316" width="14" height="14" rx="3" fill="none" stroke="#fff" stroke-width="2"/>
          <rect x="494" y="316" width="14" height="14" rx="3" fill="none" stroke="#fff" stroke-width="2" opacity=".65"/>
          <line x1="476" y1="344" x2="504" y2="344" stroke="#fff" stroke-width="2" stroke-linecap="round" opacity=".8"/>
          <line x1="476" y1="352" x2="496" y2="352" stroke="#fff" stroke-width="2" stroke-linecap="round" opacity=".5"/>
          <text x="536" y="334" class="gw-lbl">Smart Gateway</text>
          <text x="490" y="436" text-anchor="middle" class="zigbee-lbl halo">Zigbee / BLE-mesh</text>
        </g>

        <!-- gateway 2 (bridge) -->
        <g class="float" style="animation-delay:1.1s">
          <rect x="672" y="300" width="76" height="76" rx="16" fill="#fff" stroke="#F97316" stroke-width="1.8"/>
          <rect x="692" y="316" width="14" height="14" rx="3" fill="none" stroke="#F97316" stroke-width="2"/>
          <rect x="714" y="316" width="14" height="14" rx="3" fill="none" stroke="#F97316" stroke-width="2" opacity=".6"/>
          <line x1="696" y1="344" x2="724" y2="344" stroke="#F97316" stroke-width="2" stroke-linecap="round" opacity=".7"/>
          <text x="756" y="334" class="gw-lbl2">Bridge Gateway</text>
          <text x="710" y="436" text-anchor="middle" class="zigbee-lbl halo">Zigbee / BLE-mesh</text>
        </g>

        <!-- ============ matter chip ============ -->
        <g class="float" style="animation-delay:.7s">
          <rect x="915" y="415" width="210" height="40" rx="12" fill="#fff" stroke="#F97316" stroke-width="1.4" stroke-dasharray="4 4"/>
          <text x="1020" y="432" text-anchor="middle" class="matter-lbl">Matter</text>
          <text x="1020" y="448" text-anchor="middle" class="note">over Wi-Fi · over Thread</text>
        </g>

        <!-- ============ device row ============ -->
        <!-- 1 wire-free switch -->
        <g class="float" style="animation-delay:.1s">
          <rect x="80" y="492" width="40" height="40" rx="8" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <rect x="90" y="500" width="20" height="14" rx="3" fill="none" stroke="#F97316" stroke-width="1.5"/>
          <circle cx="100" cy="523" r="3" fill="#F97316"/>
          <text x="100" y="551" text-anchor="middle" class="lbl">Wire-Free</text>
          <text x="100" y="564" text-anchor="middle" class="lbl">Switch</text>
        </g>
        <!-- 2 smart switch 1/2/3/4 -->
        <g class="float" style="animation-delay:.5s">
          <rect x="180" y="492" width="40" height="40" rx="8" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <rect x="188" y="500" width="10" height="10" rx="2" fill="none" stroke="#F97316" stroke-width="1.4"/>
          <rect x="202" y="500" width="10" height="10" rx="2" fill="none" stroke="#F97316" stroke-width="1.4"/>
          <rect x="188" y="514" width="10" height="10" rx="2" fill="none" stroke="#F97316" stroke-width="1.4"/>
          <rect x="202" y="514" width="10" height="10" rx="2" fill="none" stroke="#F97316" stroke-width="1.4"/>
          <text x="200" y="551" text-anchor="middle" class="lbl">Smart Switch</text>
          <text x="200" y="564" text-anchor="middle" class="lbl">1 / 2 / 3 / 4</text>
        </g>
        <!-- 3 thermostat -->
        <g class="float" style="animation-delay:.9s">
          <circle cx="300" cy="512" r="17" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <text x="300" y="516" text-anchor="middle" class="lbl" style="font-size:12px; font-weight:600; fill:#475569">26°</text>
          <text x="300" y="551" text-anchor="middle" class="lbl">Thermostat</text>
        </g>
        <!-- 4 curtain motor -->
        <g class="float" style="animation-delay:1.3s">
          <rect x="380" y="496" width="40" height="22" rx="4" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <line x1="391" y1="496" x2="391" y2="518" stroke="#CBD5E1" stroke-width="1.2"/>
          <line x1="400" y1="496" x2="400" y2="518" stroke="#CBD5E1" stroke-width="1.2"/>
          <line x1="409" y1="496" x2="409" y2="518" stroke="#CBD5E1" stroke-width="1.2"/>
          <line x1="380" y1="526" x2="420" y2="526" stroke="#E2E8F0" stroke-width="1.4"/>
          <text x="400" y="551" text-anchor="middle" class="lbl">Curtain Motor</text>
        </g>
        <!-- 5 smart door lock -->
        <g class="float" style="animation-delay:1.7s">
          <rect x="488" y="492" width="24" height="40" rx="5" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <circle cx="500" cy="506" r="3.5" fill="none" stroke="#F97316" stroke-width="1.5"/>
          <line x1="500" y1="509" x2="500" y2="518" stroke="#F97316" stroke-width="1.5"/>
          <line x1="507" y1="510" x2="512" y2="510" stroke="#CBD5E1" stroke-width="1.4"/>
          <text x="500" y="551" text-anchor="middle" class="lbl">Smart Door</text>
          <text x="500" y="564" text-anchor="middle" class="lbl">Lock</text>
        </g>
        <!-- 6 IR remote controller -->
        <g class="float" style="animation-delay:2.1s">
          <rect x="588" y="492" width="24" height="40" rx="5" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <circle cx="600" cy="501" r="2.5" fill="#F97316"/>
          <circle cx="600" cy="510" r="2.5" fill="#CBD5E1"/>
          <circle cx="600" cy="519" r="2.5" fill="#CBD5E1"/>
          <path d="M616 498 q5 5 0 10" fill="none" stroke="#F97316" stroke-width="1.4" stroke-linecap="round"/>
          <text x="600" y="551" text-anchor="middle" class="lbl">IR Remote</text>
          <text x="600" y="564" text-anchor="middle" class="lbl">Controller</text>
        </g>
        <!-- 7 camera -->
        <g class="float" style="animation-delay:.4s">
          <path d="M682 516 a18 18 0 0 1 36 0 z" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <circle cx="700" cy="507" r="4" fill="none" stroke="#F97316" stroke-width="1.5"/>
          <line x1="678" y1="518" x2="722" y2="518" stroke="#CBD5E1" stroke-width="1.6" stroke-linecap="round"/>
          <text x="700" y="551" text-anchor="middle" class="lbl">Camera</text>
        </g>
        <!-- 8 smoke alarm -->
        <g class="float" style="animation-delay:.8s">
          <circle cx="800" cy="512" r="16" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <circle cx="800" cy="512" r="7" fill="none" stroke="#F97316" stroke-width="1.3" stroke-dasharray="3 3"/>
          <text x="800" y="551" text-anchor="middle" class="lbl">Smoke Alarm</text>
        </g>
        <!-- 9 motion sensor -->
        <g class="float" style="animation-delay:1.2s">
          <rect x="890" y="494" width="20" height="34" rx="9" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <path d="M897 502 q4 8 0 16" fill="none" stroke="#F97316" stroke-width="1.3" stroke-linecap="round"/>
          <path d="M903 500 q6 10 0 20" fill="none" stroke="#F97316" stroke-width="1.3" stroke-linecap="round"/>
          <text x="900" y="551" text-anchor="middle" class="lbl">Motion Sensor</text>
        </g>
        <!-- 10 door contact -->
        <g class="float" style="animation-delay:1.6s">
          <rect x="984" y="496" width="12" height="32" rx="3" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <rect x="1002" y="496" width="16" height="32" rx="5" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <circle cx="1010" cy="512" r="2.5" fill="#F97316"/>
          <text x="1000" y="551" text-anchor="middle" class="lbl">Door Contact</text>
        </g>
        <!-- 11 control panel -->
        <g class="float" style="animation-delay:2s">
          <rect x="1076" y="492" width="48" height="38" rx="6" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <rect x="1084" y="499" width="22" height="16" rx="2" fill="none" stroke="#F97316" stroke-width="1.4"/>
          <circle cx="1116" cy="505" r="2.5" fill="#F97316"/>
          <circle cx="1116" cy="513" r="2.5" fill="#CBD5E1"/>
          <line x1="1084" y1="522" x2="1114" y2="522" stroke="#CBD5E1" stroke-width="1.3"/>
          <text x="1100" y="551" text-anchor="middle" class="lbl">Control Panel</text>
        </g>

        <!-- ============ sub row : IR / RF appliances ============ -->
        <!-- fan -->
        <g class="float" style="animation-delay:.3s">
          <g stroke="#94A3B8" stroke-width="2" stroke-linecap="round">
            <line x1="560" y1="610" x2="560" y2="597"/>
            <line x1="560" y1="610" x2="571" y2="617"/>
            <line x1="560" y1="610" x2="549" y2="617"/>
          </g>
          <circle cx="560" cy="610" r="3.5" fill="none" stroke="#F97316" stroke-width="1.5"/>
          <text x="560" y="640" text-anchor="middle" class="lbl">Fan</text>
        </g>
        <!-- garage -->
        <g class="float" style="animation-delay:.9s">
          <path d="M637 606 L655 593 L673 606" fill="none" stroke="#94A3B8" stroke-width="1.8" stroke-linejoin="round"/>
          <rect x="639" y="606" width="32" height="20" rx="2" fill="#fff" stroke="#94A3B8" stroke-width="1.6"/>
          <rect x="648" y="611" width="14" height="15" fill="none" stroke="#F97316" stroke-width="1.4"/>
          <text x="655" y="640" text-anchor="middle" class="lbl">Garage Door</text>
        </g>
        <!-- RF remote -->
        <g class="float" style="animation-delay:1.5s">
          <rect x="741" y="598" width="18" height="30" rx="5" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <circle cx="750" cy="606" r="2.2" fill="#F97316"/>
          <circle cx="750" cy="613" r="2.2" fill="#CBD5E1"/>
          <circle cx="750" cy="620" r="2.2" fill="#CBD5E1"/>
          <path d="M762 596 q5 4 0 9" fill="none" stroke="#F97316" stroke-width="1.3" stroke-linecap="round"/>
          <text x="755" y="640" text-anchor="middle" class="lbl">RF Remote</text>
        </g>

        <defs>
          <linearGradient id="hubGrad" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#FB923C"/>
            <stop offset="1" stop-color="#F97316"/>
          </linearGradient>
        </defs>
      </svg>
    </div>
  </div>
</section>

<style>
  .eco {
    background: #f8fafc;
  }

  /* heading: same family / size / orange gradient as the hero headline */
  .eco-heading {
    margin: 0 0 1.5rem;
    font-family: var(--font-secondary);
    font-weight: 700;
    line-height: 1.25;
    font-size: var(--text-h1-sm);
    background-image: linear-gradient(to left, #f97316, #fb923c, #fbbf24);
    background-repeat: no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }

  /* same, for nodes injected by the browser's page translator */
  :global(.eco-heading *) {
    background-image: linear-gradient(to left, #f97316, #fb923c, #fbbf24);
    background-repeat: no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }

  @media (min-width: 48rem) {
    .eco-heading {
      font-size: var(--text-h1);
    }
  }

  /* the diagram gets a wider track than the page grid so it reads bigger */
  .eco-wide {
    max-width: 1360px !important;
  }

  .eco-figure {
    width: 100%;
    max-width: 100%;
  }
  .eco-figure svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .lbl {
    font-size: 11.5px;
    fill: #64748b;
  }
  .note {
    font-size: 12px;
    font-style: italic;
    fill: #94a3b8;
  }
  .row-lbl {
    font-size: 15px;
    font-weight: 600;
    fill: #1f2937;
  }
  .box-head {
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    fill: #94a3b8;
  }
  .chip-lbl {
    font-size: 12.5px;
    font-weight: 600;
    fill: #ea580c;
  }
  .tuya-lbl {
    font-size: 14px;
    font-weight: 700;
    fill: #c2410c;
  }
  .gw-lbl {
    font-size: 14px;
    font-weight: 700;
    fill: #ea580c;
  }
  .gw-lbl2 {
    font-size: 14px;
    font-weight: 600;
    fill: #475569;
  }
  .zigbee-lbl {
    font-size: 14px;
    font-weight: 700;
    fill: #334155;
  }
  .matter-lbl {
    font-size: 15px;
    font-weight: 700;
    fill: #ea580c;
  }

  /* text knocked out over dashed lines */
  .halo {
    paint-order: stroke;
    stroke: #f8fafc;
    stroke-width: 9px;
    stroke-linejoin: round;
  }

  /* flowing dashed links */
  .flow {
    stroke-dasharray: 5 7;
    animation: eco-dash 1.1s linear infinite;
  }
  @keyframes eco-dash {
    to {
      stroke-dashoffset: -24;
    }
  }

  /* gentle floating */
  .float {
    animation: eco-bob 4.5s ease-in-out infinite;
  }
  @keyframes eco-bob {
    0%,
    100% {

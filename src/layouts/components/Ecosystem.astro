---
// "Smart Home Communication Mode" — full-width, wide/short ecosystem diagram.
// Orthogonal (right-angle) dashed routing like the reference material.
// All devices from the source diagram are included. Zero dependencies.
---

<section class="section eco">
  <div class="container">
    <h2 class="eco-heading">Smart Home Communication Mode</h2>
  </div>

  <div class="container eco-wide">
    <div class="eco-figure">
      <svg viewBox="45 11 1120 576" role="img" aria-label="Smart home communication diagram: cloud, router and mobile phone outside the home; Wi-Fi branches to voice assistants and the Tuya platform gateways (Zigbee / BLE-mesh); Matter over Wi-Fi and Thread; a device bus connects wire-free switch, smart switches 1-4, thermostat, curtain motor, smart door lock, IR remote controller, camera, smoke alarm, motion sensor, door contact, control panel, plus fan, garage door with a car pulling out, and RF remote.">
        <!-- decorations -->
        <g>
          <circle cx="330" cy="118" r="3" fill="#F97316" opacity=".45"/>
          <circle cx="880" cy="128" r="3" fill="#22C55E" opacity=".45"/>
          <circle cx="75" cy="190" r="3" fill="#3B82F6" opacity=".4"/>
          <circle cx="1160" cy="220" r="3" fill="#F97316" opacity=".4"/>
          <circle cx="905" cy="500" r="3" fill="#22C55E" opacity=".4"/>
        </g>

        <!-- ============ orthogonal links ============ -->
        <g fill="none" stroke="rgba(249,115,22,.45)" stroke-width="1.6">
          <!-- cloud <-> mobile -->
          <path class="flow" d="M645 45 H1020"/>
          <!-- cloud -> router -->
          <path class="flow" d="M600 67 V106"/>
          <!-- router -> branch bus -->
          <path class="flow" d="M600 144 V174"/>
          <!-- branch bus -->
          <path class="flow" d="M180 174 H1020"/>
          <!-- branches down to boxes -->
          <path class="flow" d="M180 174 V212"/>
          <path class="flow" d="M1020 174 V212"/>
          <!-- branch drops to gateways -->
          <path class="flow" d="M490 174 V242"/>
          <path class="flow" d="M710 174 V242"/>
          <!-- voice box -> tuya zone -->
          <path class="flow" d="M300 272 H330"/>
          <!-- right box -> matter -> bus -->
          <path class="flow" d="M1020 337 V352"/>
          <path class="flow" d="M1020 392 V411"/>
          <!-- gateways -> device bus -->
          <path class="flow" d="M490 318 V411"/>
          <path class="flow" d="M710 318 V411"/>
          <!-- device bus -->
          <path class="flow" d="M70 411 H1130"/>
          <!-- bus -> sub bus (IR/RF appliances) -->
          <path class="flow" d="M655 411 V519"/>
          <path class="flow" d="M545 507 H765"/>
          <path class="flow" d="M560 507 V519"/>
          <path class="flow" d="M750 507 V519"/>
          <!-- device stubs -->
          <path class="flow" d="M100 411 V423"/>
          <path class="flow" d="M200 411 V423"/>
          <path class="flow" d="M300 411 V423"/>
          <path class="flow" d="M400 411 V423"/>
          <path class="flow" d="M500 411 V423"/>
          <path class="flow" d="M600 411 V423"/>
          <path class="flow" d="M700 411 V423"/>
          <path class="flow" d="M800 411 V423"/>
          <path class="flow" d="M900 411 V423"/>
          <path class="flow" d="M1000 411 V423"/>
          <path class="flow" d="M1100 411 V423"/>
        </g>

        <!-- ============ traveling packets ============ -->
        <g class="pkts">
          <!-- cloud -> router -->
          <circle class="pkt" r="3.2" fill="#F97316">
            <animateMotion dur="1.6s" repeatCount="indefinite" path="M600 67 L600 106"/>
          </circle>
          <!-- router -> branch bus -> left gateway -->
          <circle class="pkt" r="3.2" fill="#FB923C">
            <animateMotion dur="2.6s" repeatCount="indefinite" path="M600 144 L600 174 L490 174 L490 242"/>
          </circle>
          <!-- router -> branch bus -> right gateway -->
          <circle class="pkt" r="3" fill="#FBBF24">
            <animateMotion dur="2s" begin="0.9s" repeatCount="indefinite" path="M600 174 L710 174 L710 242"/>
          </circle>
          <!-- right gateway -> device bus -> matter -->
          <circle class="pkt" r="3" fill="#FB923C">
            <animateMotion dur="3.4s" repeatCount="indefinite" path="M710 318 L710 411 L1020 411 L1020 393"/>
          </circle>
          <!-- cloud -> mobile phone -->
          <circle class="pkt" r="3" fill="#F97316">
            <animateMotion dur="3s" repeatCount="indefinite" path="M645 45 L1020 45"/>
          </circle>
          <!-- mobile phone -> cloud (return) -->
          <circle class="pkt" r="2.8" fill="#FBBF24">
            <animateMotion dur="3s" begin="1.5s" repeatCount="indefinite" path="M1020 45 L645 45"/>
          </circle>
          <!-- branch bus -> voice control box -->
          <circle class="pkt" r="2.8" fill="#FB923C">
            <animateMotion dur="2.2s" begin="1.1s" repeatCount="indefinite" path="M600 174 L180 174 L180 212"/>
          </circle>
          <!-- branch bus -> ecosystem box -->
          <circle class="pkt" r="2.8" fill="#FBBF24">
            <animateMotion dur="2.2s" begin="0.4s" repeatCount="indefinite" path="M600 174 L1020 174 L1020 212"/>
          </circle>
          <!-- voice control box -> tuya zone -->
          <circle class="pkt" r="2.6" fill="#F97316">
            <animateMotion dur="1.2s" repeatCount="indefinite" path="M300 272 L330 272"/>
          </circle>
          <!-- left gateway -> device bus -> wire-free switch -->
          <circle class="pkt" r="2.8" fill="#FB923C">
            <animateMotion dur="3.2s" begin="0.6s" repeatCount="indefinite" path="M490 318 L490 411 L100 411 L100 423"/>
          </circle>
          <!-- device bus sweep to the control panel -->
          <circle class="pkt" r="2.8" fill="#F97316">
            <animateMotion dur="3s" begin="1.8s" repeatCount="indefinite" path="M710 411 L1100 411 L1100 423"/>
          </circle>
          <!-- device bus -> IR sub bus -> fan -->
          <circle class="pkt" r="2.8" fill="#FBBF24">
            <animateMotion dur="3s" begin="0.8s" repeatCount="indefinite" path="M490 411 L655 411 L655 507 L560 507 L560 519"/>
          </circle>
          <!-- IR sub bus -> RF remote -->
          <circle class="pkt" r="2.6" fill="#FB923C">
            <animateMotion dur="1.9s" begin="1.6s" repeatCount="indefinite" path="M655 507 L750 507 L750 519"/>
          </circle>
        </g>

        <!-- ============ junction dots ============ -->
        <g>
          <circle cx="490" cy="174" r="3" fill="#F97316" opacity=".7"/>
          <circle cx="710" cy="174" r="3" fill="#F97316" opacity=".7"/>
          <circle cx="490" cy="411" r="3" fill="#F97316" opacity=".7"/>
          <circle cx="710" cy="411" r="3" fill="#F97316" opacity=".7"/>
          <circle cx="1020" cy="411" r="3" fill="#F97316" opacity=".7"/>
        </g>

        <!-- ============ cloud ============ -->
        <g class="float" style="animation-delay:0s">
          <path d="M579 67 q-24 0 -24 -12 q0 -11 18 -12 q6 -11 27 -11 q21 0 27 11 q18 1 18 12 q0 12 -24 12 z"
                fill="#fff" stroke="#F97316" stroke-width="2"/>
          <text x="600" y="88" text-anchor="middle" class="lbl halo">Cloud</text>
        </g>

        <!-- ============ mobile ============ -->
        <g class="float" style="animation-delay:.6s">
          <rect x="1024" y="18" width="32" height="56" rx="7" fill="#fff" stroke="#94A3B8" stroke-width="1.8"/>
          <line x1="1034" y1="66" x2="1046" y2="66" stroke="#94A3B8" stroke-width="1.8" stroke-linecap="round"/>
          <text x="1040" y="88" text-anchor="middle" class="lbl">Mobile Phone</text>
        </g>
        <text x="832" y="35" text-anchor="middle" class="note">Outside the home</text>

        <!-- ============ router ============ -->
        <g class="float" style="animation-delay:.3s">
          <line x1="578" y1="120" x2="572" y2="106" stroke="#94A3B8" stroke-width="2" stroke-linecap="round"/>
          <line x1="622" y1="120" x2="628" y2="106" stroke="#94A3B8" stroke-width="2" stroke-linecap="round"/>
          <rect x="558" y="120" width="84" height="24" rx="7" fill="#fff" stroke="#94A3B8" stroke-width="1.8"/>
          <circle class="led" cx="572" cy="132" r="2.4" fill="#F97316" style="animation-delay:0s"/>
          <circle class="led" cx="583" cy="132" r="2.4" fill="#FBBF24" style="animation-delay:.25s"/>
          <circle class="led" cx="594" cy="132" r="2.4" fill="#22C55E" style="animation-delay:.5s"/>
          <text x="600" y="160" text-anchor="middle" class="lbl halo">Router</text>
        </g>

        <!-- wi-fi chips on the branch bus -->
        <g class="float" style="animation-delay:.9s">
          <rect x="348" y="164" width="64" height="20" rx="10" fill="#FFF7ED" stroke="#F97316" stroke-width="1.4"/>
          <g fill="none" stroke="#EA580C" stroke-width="1.5" stroke-linecap="round">
            <path d="M353.5 171.5 a13 13 0 0 1 17 0"/>
            <path d="M356.5 174.5 a9 9 0 0 1 11 0"/>
            <path d="M359.5 177.5 a5 5 0 0 1 5 0"/>
          </g>
          <circle cx="362" cy="181" r="1.4" fill="#EA580C"/>
          <text x="376" y="178" class="chip-lbl">Wi-Fi</text>
        </g>
        <g class="float" style="animation-delay:1.5s">
          <rect x="788" y="164" width="64" height="20" rx="10" fill="#FFF7ED" stroke="#F97316" stroke-width="1.4"/>
          <g fill="none" stroke="#EA580C" stroke-width="1.5" stroke-linecap="round">
            <path d="M793.5 171.5 a13 13 0 0 1 17 0"/>
            <path d="M796.5 174.5 a9 9 0 0 1 11 0"/>
            <path d="M799.5 177.5 a5 5 0 0 1 5 0"/>
          </g>
          <circle cx="802" cy="181" r="1.4" fill="#EA580C"/>
          <text x="816" y="178" class="chip-lbl">Wi-Fi</text>
        </g>

        <!-- ============ left box : voice control ============ -->
        <g>
          <rect x="60" y="212" width="240" height="120" rx="14" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <text x="180" y="237" text-anchor="middle" class="box-head">Voice Control</text>
          <circle cx="100" cy="264" r="11" fill="#F1F5F9" stroke="#CBD5E1" stroke-width="1.4"/>
          <circle cx="100" cy="264" r="4" fill="#94A3B8"/>
          <text x="122" y="269" class="row-lbl">Amazon Alexa</text>
          <circle cx="100" cy="302" r="11" fill="#F1F5F9" stroke="#CBD5E1" stroke-width="1.4"/>
          <circle cx="100" cy="302" r="4" fill="#94A3B8"/>
          <text x="122" y="307" class="row-lbl">Hey Google</text>
        </g>

        <!-- ============ right box : ecosystems ============ -->
        <g>
          <rect x="900" y="212" width="240" height="125" rx="14" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <circle cx="935" cy="243" r="11" fill="#F1F5F9" stroke="#CBD5E1" stroke-width="1.4"/>
          <circle cx="935" cy="243" r="4" fill="#94A3B8"/>
          <text x="957" y="248" class="row-lbl">Apple HomePod</text>
          <circle cx="935" cy="276" r="11" fill="#F1F5F9" stroke="#CBD5E1" stroke-width="1.4"/>
          <circle cx="935" cy="276" r="4" fill="#94A3B8"/>
          <text x="957" y="281" class="row-lbl">Amazon Echo</text>
          <circle cx="935" cy="309" r="11" fill="#F1F5F9" stroke="#CBD5E1" stroke-width="1.4"/>
          <circle cx="935" cy="309" r="4" fill="#94A3B8"/>
          <text x="957" y="314" class="row-lbl">Google Nest</text>
        </g>

        <!-- ============ tuya platform zone ============ -->
        <text x="600" y="204" text-anchor="middle" class="tuya-lbl halo">Tuya Platform Ready</text>
        <rect x="330" y="212" width="540" height="165" rx="18" fill="none"
              stroke="#F87171" stroke-width="1.6" stroke-dasharray="7 6"/>

        <!-- gateway 1 (main) -->
        <g class="float" style="animation-delay:.2s">
          <rect x="452" y="242" width="76" height="76" rx="16" fill="url(#hubGrad)" stroke="#EA580C" stroke-width="1.6"/>
          <rect x="472" y="258" width="14" height="14" rx="3" fill="none" stroke="#fff" stroke-width="2"/>
          <rect x="494" y="258" width="14" height="14" rx="3" fill="none" stroke="#fff" stroke-width="2" opacity=".65"/>
          <line x1="476" y1="286" x2="504" y2="286" stroke="#fff" stroke-width="2" stroke-linecap="round" opacity=".8"/>
          <line x1="476" y1="294" x2="496" y2="294" stroke="#fff" stroke-width="2" stroke-linecap="round" opacity=".5"/>
          <text x="444" y="276" text-anchor="end" class="gw-lbl">Smart Gateway</text>
          <text x="490" y="358" text-anchor="middle" class="zigbee-lbl halo">Zigbee / BLE-mesh</text>
        </g>

        <!-- gateway 2 (bridge) -->
        <g class="float" style="animation-delay:1.1s">
          <rect x="672" y="242" width="76" height="76" rx="16" fill="#fff" stroke="#F97316" stroke-width="1.8"/>
          <rect x="692" y="258" width="14" height="14" rx="3" fill="none" stroke="#F97316" stroke-width="2"/>
          <rect x="714" y="258" width="14" height="14" rx="3" fill="none" stroke="#F97316" stroke-width="2" opacity=".6"/>
          <line x1="696" y1="286" x2="724" y2="286" stroke="#F97316" stroke-width="2" stroke-linecap="round" opacity=".7"/>
          <text x="756" y="276" class="gw-lbl2">Bridge Gateway</text>
          <text x="710" y="358" text-anchor="middle" class="zigbee-lbl halo">Zigbee / BLE-mesh</text>
        </g>

        <!-- ============ matter chip ============ -->
        <g class="float" style="animation-delay:.7s">
          <rect x="915" y="352" width="210" height="40" rx="12" fill="#fff" stroke="#F97316" stroke-width="1.4" stroke-dasharray="4 4"/>
          <text x="1020" y="369" text-anchor="middle" class="matter-lbl">Matter</text>
          <text x="1020" y="385" text-anchor="middle" class="note">over Wi-Fi · over Thread</text>
        </g>

        <!-- ============ device row ============ -->
        <!-- 1 wire-free switch -->
        <g class="float" style="animation-delay:.1s">
          <rect x="80" y="423" width="40" height="40" rx="8" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <rect x="90" y="431" width="20" height="14" rx="3" fill="none" stroke="#F97316" stroke-width="1.5"/>
          <circle cx="100" cy="454" r="3" fill="#F97316"/>
          <text x="100" y="482" text-anchor="middle" class="lbl">Wire-Free</text>
          <text x="100" y="495" text-anchor="middle" class="lbl">Switch</text>
        </g>
        <!-- 2 smart switch 1/2/3/4 -->
        <g class="float" style="animation-delay:.5s">
          <rect x="180" y="423" width="40" height="40" rx="8" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <rect x="188" y="431" width="10" height="10" rx="2" fill="none" stroke="#F97316" stroke-width="1.4"/>
          <rect x="202" y="431" width="10" height="10" rx="2" fill="none" stroke="#F97316" stroke-width="1.4"/>
          <rect x="188" y="445" width="10" height="10" rx="2" fill="none" stroke="#F97316" stroke-width="1.4"/>
          <rect x="202" y="445" width="10" height="10" rx="2" fill="none" stroke="#F97316" stroke-width="1.4"/>
          <text x="200" y="482" text-anchor="middle" class="lbl">Smart Switch</text>
          <text x="200" y="495" text-anchor="middle" class="lbl">1 / 2 / 3 / 4</text>
        </g>
        <!-- 3 thermostat -->
        <g class="float" style="animation-delay:.9s">
          <circle cx="300" cy="443" r="17" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <text x="300" y="447" text-anchor="middle" class="lbl" style="font-size:12px; font-weight:600; fill:#475569">26°</text>
          <text x="300" y="482" text-anchor="middle" class="lbl">Thermostat</text>
        </g>
        <!-- 4 curtain motor -->
        <g class="float" style="animation-delay:1.3s">
          <rect x="380" y="427" width="40" height="22" rx="4" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <line x1="391" y1="427" x2="391" y2="449" stroke="#CBD5E1" stroke-width="1.2"/>
          <line x1="400" y1="427" x2="400" y2="449" stroke="#CBD5E1" stroke-width="1.2"/>
          <line x1="409" y1="427" x2="409" y2="449" stroke="#CBD5E1" stroke-width="1.2"/>
          <line x1="380" y1="457" x2="420" y2="457" stroke="#E2E8F0" stroke-width="1.4"/>
          <text x="400" y="482" text-anchor="middle" class="lbl">Curtain Motor</text>
        </g>
        <!-- 5 smart door lock -->
        <g class="float" style="animation-delay:1.7s">
          <rect x="488" y="423" width="24" height="40" rx="5" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <circle cx="500" cy="437" r="3.5" fill="none" stroke="#F97316" stroke-width="1.5"/>
          <line x1="500" y1="440" x2="500" y2="449" stroke="#F97316" stroke-width="1.5"/>
          <line x1="507" y1="441" x2="512" y2="441" stroke="#CBD5E1" stroke-width="1.4"/>
          <text x="500" y="482" text-anchor="middle" class="lbl">Smart Door</text>
          <text x="500" y="495" text-anchor="middle" class="lbl">Lock</text>
        </g>
        <!-- 6 IR remote controller -->
        <g class="float" style="animation-delay:2.1s">
          <rect x="588" y="423" width="24" height="40" rx="5" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <circle cx="600" cy="432" r="2.5" fill="#F97316"/>
          <circle cx="600" cy="441" r="2.5" fill="#CBD5E1"/>
          <circle cx="600" cy="450" r="2.5" fill="#CBD5E1"/>
          <path d="M616 429 q5 5 0 10" fill="none" stroke="#F97316" stroke-width="1.4" stroke-linecap="round"/>
          <text x="600" y="482" text-anchor="middle" class="lbl">IR Remote</text>
          <text x="600" y="495" text-anchor="middle" class="lbl">Controller</text>
        </g>
        <!-- 7 camera -->
        <g class="float" style="animation-delay:.4s">
          <path d="M682 447 a18 18 0 0 1 36 0 z" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <circle cx="700" cy="438" r="4" fill="none" stroke="#F97316" stroke-width="1.5"/>
          <line x1="678" y1="449" x2="722" y2="449" stroke="#CBD5E1" stroke-width="1.6" stroke-linecap="round"/>
          <text x="700" y="482" text-anchor="middle" class="lbl">Camera</text>
        </g>
        <!-- 8 smoke alarm -->
        <g class="float" style="animation-delay:.8s">
          <circle cx="800" cy="443" r="16" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <circle cx="800" cy="443" r="7" fill="none" stroke="#F97316" stroke-width="1.3" stroke-dasharray="3 3"/>
          <text x="800" y="482" text-anchor="middle" class="lbl">Smoke Alarm</text>
        </g>
        <!-- 9 motion sensor -->
        <g class="float" style="animation-delay:1.2s">
          <rect x="890" y="425" width="20" height="34" rx="9" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <path d="M897 433 q4 8 0 16" fill="none" stroke="#F97316" stroke-width="1.3" stroke-linecap="round"/>
          <path d="M903 431 q6 10 0 20" fill="none" stroke="#F97316" stroke-width="1.3" stroke-linecap="round"/>
          <text x="900" y="482" text-anchor="middle" class="lbl">Motion Sensor</text>
        </g>
        <!-- 10 door contact -->
        <g class="float" style="animation-delay:1.6s">
          <rect x="984" y="427" width="12" height="32" rx="3" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <rect x="1002" y="427" width="16" height="32" rx="5" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <circle cx="1010" cy="443" r="2.5" fill="#F97316"/>
          <text x="1000" y="482" text-anchor="middle" class="lbl">Door Contact</text>
        </g>
        <!-- 11 control panel -->
        <g class="float" style="animation-delay:2s">
          <rect x="1076" y="423" width="48" height="38" rx="6" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <rect x="1084" y="430" width="22" height="16" rx="2" fill="none" stroke="#F97316" stroke-width="1.4"/>
          <circle cx="1116" cy="436" r="2.5" fill="#F97316"/>
          <circle cx="1116" cy="444" r="2.5" fill="#CBD5E1"/>
          <line x1="1084" y1="453" x2="1114" y2="453" stroke="#CBD5E1" stroke-width="1.3"/>
          <text x="1100" y="482" text-anchor="middle" class="lbl">Control Panel</text>
        </g>

        <!-- ============ sub row : IR / RF appliances ============ -->
        <!-- fan (blades spin) -->
        <g>
          <g class="fan-blades" stroke="#94A3B8" stroke-width="2" stroke-linecap="round">
            <line x1="560" y1="539" x2="560" y2="526"/>
            <line x1="560" y1="539" x2="571" y2="546"/>
            <line x1="560" y1="539" x2="549" y2="546"/>
          </g>
          <circle cx="560" cy="539" r="3.5" fill="none" stroke="#F97316" stroke-width="1.5"/>
          <text x="560" y="578" text-anchor="middle" class="lbl">Fan</text>
        </g>
        <!-- garage (a car drives out to the left, nose first) -->
        <g>
          <path d="M637 535 L655 522 L673 535" fill="none" stroke="#94A3B8" stroke-width="1.8" stroke-linejoin="round"/>
          <g class="eco-car">
            <path d="M649 546 L651.5 541.5 Q652 541 653 541 L658.5 541 Q659.5 541 660 541.5 L662.5 546 Z" fill="#F97316"/>
            <rect x="644" y="546" width="20" height="7" rx="2.5" fill="#F97316"/>
            <path d="M650.8 545.6 L652.7 542.6 L656.8 542.6 L658.6 545.6 Z" fill="#FFEDD5"/>
            <circle cx="645.8" cy="549" r="1.1" fill="#FEF3C7"/>
            <circle cx="648.5" cy="553" r="2" fill="#475569"/>
            <circle cx="659.5" cy="553" r="2" fill="#475569"/>
          </g>
          <rect x="639" y="535" width="32" height="20" rx="2" fill="#fff" stroke="#94A3B8" stroke-width="1.6"/>
          <rect x="648" y="540" width="14" height="15" fill="none" stroke="#F97316" stroke-width="1.4"/>
          <text x="655" y="578" text-anchor="middle" class="lbl">Garage</text>
        </g>
        <!-- RF remote -->
        <g class="float" style="animation-delay:1.5s">
          <rect x="741" y="527" width="18" height="30" rx="5" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <circle cx="750" cy="535" r="2.2" fill="#F97316"/>
          <circle cx="750" cy="542" r="2.2" fill="#CBD5E1"/>
          <circle cx="750" cy="549" r="2.2" fill="#CBD5E1"/>
          <path d="M762 525 q5 4 0 9" fill="none" stroke="#F97316" stroke-width="1.3" stroke-linecap="round"/>
          <text x="755" y="578" text-anchor="middle" class="lbl">RF Remote</text>

---
// "Smart Home Communication Mode" — full-width animated ecosystem diagram.
// Diagram-only (copy removed per client request): landscape SVG, zero deps.
// Flowing dashed links, traveling packets, pulsing gateway hub, floating icons.
---

<section class="section eco" aria-label="Smart home communication mode">
  <div class="container">
    <div class="eco-figure">
      <svg viewBox="0 8 980 492" role="img" aria-label="Smart home communication diagram: cloud, router and mobile connect to a gateway over Wi-Fi; the gateway links switches, sensors, locks, cameras and voice platforms over Zigbee, BLE-mesh and Matter.">
        <!-- decorations -->
        <g class="deco">
          <circle cx="140" cy="90" r="3" fill="#F97316" opacity=".5"/>
          <circle cx="930" cy="120" r="3" fill="#22C55E" opacity=".5"/>
          <circle cx="80" cy="300" r="3" fill="#3B82F6" opacity=".4"/>
          <circle cx="960" cy="330" r="3" fill="#F97316" opacity=".45"/>
          <circle cx="240" cy="486" r="3" fill="#22C55E" opacity=".4"/>
          <circle cx="760" cy="90" r="3" fill="#F97316" opacity=".4"/>
        </g>

        <!-- links -->
        <g fill="none" stroke="rgba(249,115,22,.45)" stroke-width="1.6">
          <path class="flow" d="M526 58 H852"/>
          <path class="flow" d="M490 84 V146"/>
          <path class="flow" d="M490 182 V228"/>
          <path class="flow" d="M452 258 C360 240 260 220 126 214"/>
          <path class="flow" d="M452 272 C360 272 240 280 126 286"/>
          <path class="flow" d="M452 290 C360 310 260 344 126 360"/>
          <path class="flow" d="M452 300 C360 336 250 400 128 428"/>
          <path class="flow" d="M528 258 C620 240 760 222 896 210"/>
          <path class="flow" d="M528 272 C640 272 780 270 896 270"/>
          <path class="flow" d="M528 290 C620 310 760 334 896 344"/>
          <path class="flow" d="M528 300 C640 336 770 396 898 416"/>
          <path class="flow" d="M490 316 V424"/>
          <path class="flow" d="M534 244 C566 244 588 228 612 212"/>
        </g>

        <!-- traveling packets -->
        <g class="pkts">
          <circle class="pkt" r="3.4" fill="#F97316">
            <animateMotion dur="2.6s" repeatCount="indefinite" path="M490 84 L490 228"/>
          </circle>
          <circle class="pkt" r="3" fill="#FB923C">
            <animateMotion dur="3.1s" repeatCount="indefinite" path="M452 258 C360 240 260 220 126 214"/>
          </circle>
          <circle class="pkt" r="3" fill="#FB923C">
            <animateMotion dur="3.4s" repeatCount="indefinite" path="M528 258 C620 240 760 222 896 210"/>
          </circle>
          <circle class="pkt" r="3" fill="#FBBF24">
            <animateMotion dur="2.9s" repeatCount="indefinite" path="M490 316 L490 424"/>
          </circle>
        </g>

        <!-- cloud -->
        <g class="float" style="animation-delay:0s">
          <path d="M462 76 q-20 0 -20 -17 q0 -15 15 -17 q5 -15 22 -15 q17 0 22 15 q15 2 15 17 q0 17 -20 17 z"
                fill="#fff" stroke="#F97316" stroke-width="2"/>
          <text x="490" y="96" text-anchor="middle" class="lbl">Cloud</text>
        </g>

        <!-- mobile -->
        <g class="float" style="animation-delay:.6s">
          <rect x="846" y="30" width="32" height="56" rx="7" fill="#fff" stroke="#94A3B8" stroke-width="1.8"/>
          <line x1="856" y1="78" x2="868" y2="78" stroke="#94A3B8" stroke-width="1.8" stroke-linecap="round"/>
          <text x="862" y="102" text-anchor="middle" class="lbl">Mobile</text>
        </g>

        <!-- router -->
        <g class="float" style="animation-delay:.3s">
          <line x1="468" y1="150" x2="462" y2="136" stroke="#94A3B8" stroke-width="2" stroke-linecap="round"/>
          <line x1="512" y1="150" x2="518" y2="136" stroke="#94A3B8" stroke-width="2" stroke-linecap="round"/>
          <rect x="448" y="150" width="84" height="24" rx="7" fill="#fff" stroke="#94A3B8" stroke-width="1.8"/>
          <circle cx="462" cy="162" r="2.4" fill="#F97316"/>
          <circle cx="473" cy="162" r="2.4" fill="#FBBF24"/>
          <circle cx="484" cy="162" r="2.4" fill="#22C55E"/>
          <text x="490" y="192" text-anchor="middle" class="lbl">Router</text>
        </g>

        <!-- wifi chip -->
        <g class="float" style="animation-delay:.9s">
          <rect x="520" y="196" width="44" height="20" rx="10" fill="#FFF7ED" stroke="#F97316" stroke-width="1.4"/>
          <text x="542" y="210" text-anchor="middle" class="chip-lbl">Wi-Fi</text>
        </g>

        <!-- gateway hub -->
        <g class="hub">
          <circle class="pulse" cx="490" cy="270" r="50" fill="none" stroke="#F97316" stroke-width="1.6"/>
          <circle cx="490" cy="270" r="50" fill="#F97316" opacity=".08"/>
          <rect x="452" y="232" width="76" height="76" rx="16"
                fill="url(#hubGrad)" stroke="#EA580C" stroke-width="1.6"/>
          <!-- switch-panel glyph -->
          <rect x="472" y="252" width="14" height="14" rx="3" fill="none" stroke="#fff" stroke-width="2"/>
          <rect x="494" y="252" width="14" height="14" rx="3" fill="none" stroke="#fff" stroke-width="2" opacity=".65"/>
          <line x1="476" y1="276" x2="504" y2="276" stroke="#fff" stroke-width="2" stroke-linecap="round" opacity=".8"/>
          <line x1="476" y1="284" x2="496" y2="284" stroke="#fff" stroke-width="2" stroke-linecap="round" opacity=".5"/>
          <text x="490" y="328" text-anchor="middle" class="hub-lbl">Smart Gateway</text>
        </g>

        <!-- tuya chip -->
        <g class="float" style="animation-delay:1.2s">
          <rect x="614" y="192" width="118" height="24" rx="12" fill="#fff" stroke="#F97316" stroke-width="1.4" stroke-dasharray="4 4"/>
          <text x="673" y="208" text-anchor="middle" class="chip-lbl">Tuya Platform Ready</text>
        </g>

        <!-- left devices -->
        <g class="dev float" style="animation-delay:.2s">
          <rect x="82" y="192" width="40" height="40" rx="8" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <rect x="94" y="202" width="16" height="12" rx="2" fill="none" stroke="#F97316" stroke-width="1.6"/>
          <circle cx="102" cy="222" r="2.6" fill="#F97316"/>
          <text x="102" y="250" text-anchor="middle" class="lbl">Smart Switch</text>
        </g>
        <g class="dev float" style="animation-delay:.8s">
          <circle cx="102" cy="288" r="16" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <text x="102" y="292" text-anchor="middle" class="lbl" style="font-size:9px">26°</text>
          <text x="102" y="322" text-anchor="middle" class="lbl">Thermostat</text>
        </g>
        <g class="dev float" style="animation-delay:1.4s">
          <rect x="82" y="352" width="40" height="26" rx="5" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <line x1="95" y1="352" x2="95" y2="378" stroke="#CBD5E1" stroke-width="1.2"/>
          <line x1="109" y1="352" x2="109" y2="378" stroke="#CBD5E1" stroke-width="1.2"/>
          <text x="102" y="396" text-anchor="middle" class="lbl">Curtain Motor</text>
        </g>
        <g class="dev float" style="animation-delay:2s">
          <rect x="88" y="418" width="28" height="38" rx="6" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <circle cx="102" cy="434" r="3.4" fill="none" stroke="#F97316" stroke-width="1.6"/>
          <line x1="102" y1="437" x2="102" y2="446" stroke="#F97316" stroke-width="1.6"/>
          <text x="102" y="474" text-anchor="middle" class="lbl">Smart Lock</text>
        </g>

        <!-- right devices -->
        <g class="dev float" style="animation-delay:.5s">
          <path d="M900 206 a20 20 0 0 1 40 0 z" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <circle cx="920" cy="198" r="4" fill="none" stroke="#F97316" stroke-width="1.6"/>
          <line x1="896" y1="208" x2="944" y2="208" stroke="#CBD5E1" stroke-width="1.6" stroke-linecap="round"/>
          <text x="920" y="228" text-anchor="middle" class="lbl">Camera</text>
        </g>
        <g class="dev float" style="animation-delay:1.1s">
          <circle cx="920" cy="270" r="17" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <circle cx="920" cy="270" r="8" fill="none" stroke="#F97316" stroke-width="1.4" stroke-dasharray="3 3"/>
          <text x="920" y="304" text-anchor="middle" class="lbl">Smoke Alarm</text>
        </g>
        <g class="dev float" style="animation-delay:1.7s">
          <rect x="908" y="330" width="24" height="34" rx="9" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <path d="M928 340 q6 6 0 12" fill="none" stroke="#F97316" stroke-width="1.5" stroke-linecap="round"/>
          <text x="920" y="382" text-anchor="middle" class="lbl">Motion Sensor</text>
        </g>
        <g class="dev float" style="animation-delay:2.3s">
          <rect x="898" y="404" width="44" height="32" rx="5" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
          <rect x="906" y="411" width="20" height="14" rx="2" fill="none" stroke="#F97316" stroke-width="1.4"/>
          <circle cx="935" cy="418" r="2.4" fill="#F97316"/>
          <line x1="906" y1="430" x2="932" y2="430" stroke="#CBD5E1" stroke-width="1.3"/>
          <text x="920" y="454" text-anchor="middle" class="lbl">Control Panel</text>
        </g>

        <!-- ecosystem bar -->
        <g class="float" style="animation-delay:.7s">
          <rect x="350" y="430" width="280" height="30" rx="15" fill="#FFF7ED" stroke="#F97316" stroke-width="1.4"/>
          <text x="490" y="449" text-anchor="middle" class="eco-chip-lbl">Zigbee · BLE-mesh · Matter · Alexa · Google</text>
        </g>

        <defs>
          <linearGradient id="hubGrad" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#FB923C"/>
            <stop offset="1" stop-color="#F97316"/>
          </linearGradient>
        </defs>
      </svg>
    </div>
  </div>
</section>

<style>
  .eco {
    background: #f8fafc;
  }

  .eco-figure {
    width: 100%;
    max-width: 100%;
  }
  .eco-figure svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .lbl {
    font-size: 11px;
    fill: #64748b;
  }
  .hub-lbl {
    font-size: 12px;
    font-weight: 700;
    fill: #ea580c;
  }
  .chip-lbl {
    font-size: 11px;
    font-weight: 600;
    fill: #ea580c;
  }
  .eco-chip-lbl {
    font-size: 11.5px;
    font-weight: 600;
    fill: #c2410c;
  }

  /* flowing dashed links */
  .flow {
    stroke-dasharray: 5 7;
    animation: eco-dash 1.1s linear infinite;
  }
  @keyframes eco-dash {
    to {
      stroke-dashoffset: -24;
    }
  }

  /* gentle floating */
  .float {
    animation: eco-bob 4.5s ease-in-out infinite;
  }
  @keyframes eco-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-4px);
    }
  }

  /* hub pulse ring */
  .pulse {
    transform-box: fill-box;
    transform-origin: center;
    animation: eco-pulse 2.6s ease-out infinite;
  }
  @keyframes eco-pulse {
    0% {
      transform: scale(0.65);
      opacity: 0.55;
    }
    100% {
      transform: scale(1.45);
      opacity: 0;
    }
  }

  .pkt {
    offset-rotate: 0deg;
  }

  @media (prefers-reduced-motion: reduce) {
    .flow,
    .float,
    .pulse {
      animation: none;
    }
    .pkts {
      display: none;
    }
  }
</style>

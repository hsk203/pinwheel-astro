---
// "Smart Home Communication Mode" feature section.
// Left: translated copy + CTAs. Right: animated landscape ecosystem diagram
// (SVG, zero dependencies) — flowing dashed links, traveling packets,
// pulsing gateway hub, gently floating device icons.
---

<section class="section eco">
  <div class="container">
    <div class="row items-center">
      <!-- left : copy -->
      <div class="lg:col-6">
        <p class="eco-eyebrow">Smart Home Communication Mode</p>
        <h2 class="eco-title">
          Connect Devices, Gateways &amp; the Cloud — in One Ecosystem
        </h2>
        <p class="eco-desc">
          Wi-Fi, Zigbee / BLE-mesh, and Matter run side by side on one platform.
          Every switch, sensor, lock, and camera joins the same gateway — and
          your brand can too, with Tuya-ready OEM &amp; ODM integration.
        </p>

        <div class="eco-actions">
          <a href="#contact" class="btn btn-primary eco-btn">Contact Sales</a>
          <a href="#products" class="eco-more">
            Explore Products <span class="eco-arrow" aria-hidden="true">›</span>
          </a>
        </div>

        <p class="eco-related">
          <span class="eco-related-label">Related:</span>
          <a href="#contact">Product Catalog</a>
          <a href="#contact">OEM &amp; ODM Service</a>
        </p>
      </div>

      <!-- right : animated diagram -->
      <div class="lg:col-6">
        <div class="eco-figure">
          <svg viewBox="0 0 680 500" role="img" aria-label="Smart home communication diagram: cloud, router and mobile connect to a gateway over Wi-Fi; the gateway links switches, sensors, locks, cameras and voice platforms over Zigbee, BLE-mesh and Matter.">
            <!-- decorations -->
            <g class="deco">
              <circle cx="120" cy="90" r="3" fill="#F97316" opacity=".5"/>
              <circle cx="600" cy="140" r="3" fill="#22C55E" opacity=".5"/>
              <circle cx="70" cy="300" r="3" fill="#3B82F6" opacity=".4"/>
              <circle cx="640" cy="330" r="3" fill="#F97316" opacity=".45"/>
              <circle cx="180" cy="470" r="3" fill="#22C55E" opacity=".4"/>
              <circle cx="480" cy="90" r="3" fill="#F97316" opacity=".4"/>
            </g>

            <!-- links -->
            <g fill="none" stroke="rgba(249,115,22,.45)" stroke-width="1.6">
              <path class="flow" d="M336 58 H566"/>
              <path class="flow" d="M300 84 V146"/>
              <path class="flow" d="M300 182 V228"/>
              <path class="flow" d="M262 258 C190 238 160 224 124 214"/>
              <path class="flow" d="M262 272 C200 272 160 278 124 284"/>
              <path class="flow" d="M262 290 C200 310 160 340 124 358"/>
              <path class="flow" d="M262 300 C200 336 160 396 122 430"/>
              <path class="flow" d="M338 258 C470 238 520 224 558 214"/>
              <path class="flow" d="M338 272 C440 272 500 270 562 270"/>
              <path class="flow" d="M338 290 C470 310 510 330 566 344"/>
              <path class="flow" d="M338 300 C480 336 520 392 556 418"/>
              <path class="flow" d="M300 316 V426"/>
              <path class="flow" d="M344 244 C380 244 400 224 424 214"/>
            </g>

            <!-- traveling packets -->
            <g class="pkts">
              <circle class="pkt" r="3.4" fill="#F97316">
                <animateMotion dur="2.6s" repeatCount="indefinite" path="M300 84 L300 228"/>
              </circle>
              <circle class="pkt" r="3" fill="#FB923C">
                <animateMotion dur="3.1s" repeatCount="indefinite" path="M262 258 C190 238 160 224 124 214"/>
              </circle>
              <circle class="pkt" r="3" fill="#FB923C">
                <animateMotion dur="3.4s" repeatCount="indefinite" path="M338 258 C470 238 520 224 558 214"/>
              </circle>
              <circle class="pkt" r="3" fill="#FBBF24">
                <animateMotion dur="2.9s" repeatCount="indefinite" path="M300 316 L300 414"/>
              </circle>
            </g>

            <!-- cloud -->
            <g class="float" style="animation-delay:0s">
              <path d="M272 76 q-20 0 -20 -17 q0 -15 15 -17 q5 -15 22 -15 q17 0 22 15 q15 2 15 17 q0 17 -20 17 z"
                    fill="#fff" stroke="#F97316" stroke-width="2"/>
              <text x="300" y="96" text-anchor="middle" class="lbl">Cloud</text>
            </g>

            <!-- mobile -->
            <g class="float" style="animation-delay:.6s">
              <rect x="566" y="30" width="32" height="56" rx="7" fill="#fff" stroke="#94A3B8" stroke-width="1.8"/>
              <line x1="576" y1="78" x2="588" y2="78" stroke="#94A3B8" stroke-width="1.8" stroke-linecap="round"/>
              <text x="582" y="102" text-anchor="middle" class="lbl">Mobile</text>
            </g>

            <!-- router -->
            <g class="float" style="animation-delay:.3s">
              <line x1="278" y1="150" x2="272" y2="136" stroke="#94A3B8" stroke-width="2" stroke-linecap="round"/>
              <line x1="322" y1="150" x2="328" y2="136" stroke="#94A3B8" stroke-width="2" stroke-linecap="round"/>
              <rect x="258" y="150" width="84" height="24" rx="7" fill="#fff" stroke="#94A3B8" stroke-width="1.8"/>
              <circle cx="272" cy="162" r="2.4" fill="#F97316"/>
              <circle cx="283" cy="162" r="2.4" fill="#FBBF24"/>
              <circle cx="294" cy="162" r="2.4" fill="#22C55E"/>
              <text x="300" y="192" text-anchor="middle" class="lbl">Router</text>
            </g>

            <!-- wifi chip -->
            <g class="float" style="animation-delay:.9s">
              <rect x="330" y="196" width="44" height="20" rx="10" fill="#FFF7ED" stroke="#F97316" stroke-width="1.4"/>
              <text x="352" y="210" text-anchor="middle" class="chip-lbl">Wi-Fi</text>
            </g>

            <!-- gateway hub -->
            <g class="hub">
              <circle class="pulse" cx="300" cy="270" r="50" fill="none" stroke="#F97316" stroke-width="1.6"/>
              <circle cx="300" cy="270" r="50" fill="#F97316" opacity=".08"/>
              <rect x="262" y="232" width="76" height="76" rx="16"
                    fill="url(#hubGrad)" stroke="#EA580C" stroke-width="1.6"/>
              <!-- switch-panel glyph -->
              <rect x="282" y="252" width="14" height="14" rx="3" fill="none" stroke="#fff" stroke-width="2"/>
              <rect x="304" y="252" width="14" height="14" rx="3" fill="none" stroke="#fff" stroke-width="2" opacity=".65"/>
              <line x1="286" y1="276" x2="314" y2="276" stroke="#fff" stroke-width="2" stroke-linecap="round" opacity=".8"/>
              <line x1="286" y1="284" x2="306" y2="284" stroke="#fff" stroke-width="2" stroke-linecap="round" opacity=".5"/>
              <text x="300" y="328" text-anchor="middle" class="hub-lbl">Smart Gateway</text>
            </g>

            <!-- tuya chip -->
            <g class="float" style="animation-delay:1.2s">
              <rect x="424" y="192" width="118" height="24" rx="12" fill="#fff" stroke="#F97316" stroke-width="1.4" stroke-dasharray="4 4"/>
              <text x="483" y="208" text-anchor="middle" class="chip-lbl">Tuya Platform Ready</text>
            </g>

            <!-- left devices -->
            <g class="dev float" style="animation-delay:.2s">
              <rect x="82" y="192" width="40" height="40" rx="8" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
              <rect x="94" y="202" width="16" height="12" rx="2" fill="none" stroke="#F97316" stroke-width="1.6"/>
              <circle cx="102" cy="222" r="2.6" fill="#F97316"/>
              <text x="102" y="250" text-anchor="middle" class="lbl">Smart Switch</text>
            </g>
            <g class="dev float" style="animation-delay:.8s">
              <circle cx="102" cy="288" r="16" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
              <text x="102" y="292" text-anchor="middle" class="lbl" style="font-size:9px">26°</text>
              <text x="102" y="322" text-anchor="middle" class="lbl">Thermostat</text>
            </g>
            <g class="dev float" style="animation-delay:1.4s">
              <rect x="82" y="352" width="40" height="26" rx="5" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
              <line x1="95" y1="352" x2="95" y2="378" stroke="#CBD5E1" stroke-width="1.2"/>
              <line x1="109" y1="352" x2="109" y2="378" stroke="#CBD5E1" stroke-width="1.2"/>
              <text x="102" y="396" text-anchor="middle" class="lbl">Curtain Motor</text>
            </g>
            <g class="dev float" style="animation-delay:2s">
              <rect x="88" y="418" width="28" height="38" rx="6" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
              <circle cx="102" cy="434" r="3.4" fill="none" stroke="#F97316" stroke-width="1.6"/>
              <line x1="102" y1="437" x2="102" y2="446" stroke="#F97316" stroke-width="1.6"/>
              <text x="102" y="474" text-anchor="middle" class="lbl">Smart Lock</text>
            </g>

            <!-- right devices -->
            <g class="dev float" style="animation-delay:.5s">
              <path d="M560 206 a20 20 0 0 1 40 0 z" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
              <circle cx="580" cy="198" r="4" fill="none" stroke="#F97316" stroke-width="1.6"/>
              <line x1="556" y1="208" x2="604" y2="208" stroke="#CBD5E1" stroke-width="1.6" stroke-linecap="round"/>
              <text x="580" y="228" text-anchor="middle" class="lbl">Camera</text>
            </g>
            <g class="dev float" style="animation-delay:1.1s">
              <circle cx="580" cy="270" r="17" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
              <circle cx="580" cy="270" r="8" fill="none" stroke="#F97316" stroke-width="1.4" stroke-dasharray="3 3"/>
              <text x="580" y="304" text-anchor="middle" class="lbl">Smoke Alarm</text>
            </g>
            <g class="dev float" style="animation-delay:1.7s">
              <rect x="568" y="330" width="24" height="34" rx="9" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
              <path d="M588 340 q6 6 0 12" fill="none" stroke="#F97316" stroke-width="1.5" stroke-linecap="round"/>
              <text x="580" y="382" text-anchor="middle" class="lbl">Motion Sensor</text>
            </g>
            <g class="dev float" style="animation-delay:2.3s">
              <rect x="558" y="404" width="44" height="32" rx="5" fill="#fff" stroke="#CBD5E1" stroke-width="1.6"/>
              <rect x="566" y="411" width="20" height="14" rx="2" fill="none" stroke="#F97316" stroke-width="1.4"/>
              <circle cx="595" cy="418" r="2.4" fill="#F97316"/>
              <line x1="566" y1="430" x2="592" y2="430" stroke="#CBD5E1" stroke-width="1.3"/>
              <text x="580" y="454" text-anchor="middle" class="lbl">Control Panel</text>
            </g>

            <!-- ecosystem bar -->
            <g class="float" style="animation-delay:.7s">
              <rect x="160" y="430" width="280" height="30" rx="15" fill="#FFF7ED" stroke="#F97316" stroke-width="1.4"/>
              <text x="300" y="449" text-anchor="middle" class="eco-chip-lbl">Zigbee · BLE-mesh · Matter · Alexa · Google</text>
            </g>

            <defs>
              <linearGradient id="hubGrad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#FB923C"/>
                <stop offset="1" stop-color="#F97316"/>
              </linearGradient>
            </defs>
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .eco {
    background: #f8fafc;
  }

  .eco-eyebrow {
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #f97316;
  }

  .eco-title {
    margin: 0;
    font-size: clamp(1.7rem, 3.2vw, 2.5rem);
    line-height: 1.22;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #111827;
  }

  .eco-desc {
    max-width: 34rem;
    margin: 1.1rem 0 0;
    font-size: 1.02rem;
    line-height: 1.75;
    color: #374151;
  }

  .eco-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 1.8rem;
  }

  .eco-btn {
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      filter 0.25s ease;
  }
  .eco-btn:hover {
    transform: translateY(-3px);
    filter: brightness(1.06);
    box-shadow: 0 10px 28px rgba(249, 115, 22, 0.45);
  }

  .eco-more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 600;
    color: #111827;
  }
  .eco-more:hover {
    color: #f97316;
  }
  .eco-arrow {
    font-size: 1.2em;
    line-height: 1;
    transition: transform 0.2s ease;
  }
  .eco-more:hover .eco-arrow {
    transform: translateX(3px);
  }

  .eco-related {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin: 2.2rem 0 0;
    font-size: 0.9rem;
  }
  .eco-related-label {
    font-weight: 700;
    color: #111827;
  }
  .eco-related a {
    color: #374151;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .eco-related a:hover {
    color: #f97316;
  }

  .eco-figure {
    max-width: 620px;
    margin-inline: auto;
  }
  .eco-figure svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .lbl {
    font-size: 11px;
    fill: #64748b;
  }
  .hub-lbl {
    font-size: 12px;
    font-weight: 700;
    fill: #ea580c;
  }
  .chip-lbl {
    font-size: 11px;
    font-weight: 600;
    fill: #ea580c;
  }
  .eco-chip-lbl {
    font-size: 11.5px;
    font-weight: 600;
    fill: #c2410c;
  }

  /* flowing dashed links */
  .flow {
    stroke-dasharray: 5 7;
    animation: eco-dash 1.1s linear infinite;
  }
  @keyframes eco-dash {
    to {
      stroke-dashoffset: -24;
    }
  }

  /* gentle floating */
  .float {
    animation: eco-bob 4.5s ease-in-out infinite;
  }
  @keyframes eco-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-4px);
    }
  }

  /* hub pulse ring */
  .pulse {
    transform-box: fill-box;
    transform-origin: center;
    animation: eco-pulse 2.6s ease-out infinite;
  }
  @keyframes eco-pulse {
    0% {
      transform: scale(0.65);
      opacity: 0.55;
    }
    100% {
      transform: scale(1.45);
      opacity: 0;
    }
  }

  .pkt {
    offset-rotate: 0deg;
  }

  @media (prefers-reduced-motion: reduce) {
    .flow,
    .float,
    .pulse {
      animation: none;
    }
    .pkts {
      display: none;
    }
  }
</style>

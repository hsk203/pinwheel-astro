---
import { markdownify } from "@/lib/utils/textConverter";
import { Image } from "astro:assets";
const { banner } = Astro.props;
const { title, button, image, content } = banner;
---

<section class="section banner relative">
  <div class="container">
    <div class="row items-center">
      <div class="lg:col-6">
        <h1
          class="banner-title [&>strong]:bg-gradient-to-l [&>strong]:from-[#F97316] [&>strong]:via-[#FB923C] [&>strong]:to-[#FBBF24] [&>strong]:bg-clip-text [&>strong]:text-transparent"
          set:html={markdownify(title)}
        />

        <p class="banner-subtitle mt-6" set:html={markdownify(content)} />

        {
          button.enable && (
            <a class="btn btn-primary banner-cta mt-8" href={button.link}>
              {button.label}
            </a>
          )
        }
      </div>
      <div class="lg:col-6">
        <Image
          class="w-full object-contain"
          alt="banner"
          src={image}
          width={603}
          height={396}
        />
      </div>
    </div>
  </div>

  <Image
    class="banner-shape absolute -top-28 right-0 -z-[1] w-full max-w-[30%]"
    alt="banner"
    src="/images/banner-shape.png"
    width={496}
    height={466}
  />
</section>

<style>
  .banner-subtitle {
    color: #4b5563;
  }

  .banner-cta {
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      filter 0.25s ease;
    will-change: transform;
  }

  .banner-cta:hover {
    transform: translateY(-3px);
    filter: brightness(1.06);
    box-shadow: 0 10px 28px rgba(249, 115, 22, 0.45);
  }

  .banner-cta:active {
    transform: translateY(-1px);
    box-shadow: 0 5px 16px rgba(249, 115, 22, 0.4);
  }
</style>

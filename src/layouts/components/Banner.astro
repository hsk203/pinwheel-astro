---
import { markdownify } from "@/lib/utils/textConverter";
import Globe from "@/layouts/components/Globe.astro";
const { banner } = Astro.props;
const { title, button, content } = banner;
---

<section class="section banner relative">
  <div class="container">
    <div class="row items-center">
      <div class="lg:col-6">
        <h1 class="banner-title" set:html={markdownify(title)} />

        <p class="banner-subtitle mt-6" set:html={markdownify(content)} />

        {
          button.enable && (
            <a class="btn btn-primary banner-cta mt-8" href={button.link}>
              {button.label}
            </a>
          )
        }
      </div>
      <div class="lg:col-6">
        <Globe />
      </div>
    </div>
  </div>
</section>

<style>
  /* pull the hero closer to the navbar, like the reference site */
  .banner {
    padding-top: 2rem;
  }

  /* ---- orange gradient on the bold lead-in of the headline ----
     Kept global (the class name is unique to this component) because
     Astro's scoped selectors cannot reach the <strong> that markdownify
     injects — and cannot reach the <font> nodes the browser's page
     translator wraps text runs in, which is what breaks
     background-clip:text if only the <strong> itself were styled. */
  :global(.banner-title strong),
  :global(.banner-title strong *) {
    background-image: linear-gradient(to left, #f97316, #fb923c, #fbbf24);
    background-repeat: no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }

  .banner-subtitle {
    color: #374151;
  }

  /* let the subtitle extend past the column so it wraps to two lines (font size unchanged) */
  @media (min-width: 1024px) {
    .banner-subtitle {
      margin-right: -9rem;
      max-width: none;
    }
  }

  .banner-cta {
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      filter 0.25s ease;
    will-change: transform;
  }

  .banner-cta:hover {
    transform: translateY(-3px);
    filter: brightness(1.06);
    box-shadow: 0 10px 28px rgba(249, 115, 22, 0.45);
  }

  .banner-cta:active {
    transform: translateY(-1px);
    box-shadow: 0 5px 16px rgba(249, 115, 22, 0.4);
  }
</style>

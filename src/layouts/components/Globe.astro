      const tx = cl * Math.cos(lon), ty = Math.sin(lat), tz = cl * Math.sin(lon);
      let best = landPts[0], bd = 2;
      for (const p of landPts) {
        const d = 1 - (p.x * tx + p.y * ty + p.z * tz);
        if (d < bd) { bd = d; best = p; }
      }
      return best;
    };
    const hubs = [
      nearest(121.5, 31.2),   // Shanghai
      nearest(114.0, 22.5),   // Shenzhen
      nearest(103.8, 1.35),   // Singapore
      nearest(139.7, 35.7),   // Tokyo
      nearest(55.3, 25.2),    // Dubai
      nearest(8.7, 50.1),     // Frankfurt

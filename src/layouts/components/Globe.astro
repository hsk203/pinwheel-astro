---
// 3D particle globe — canvas 2D projection, zero dependencies.
// Fibonacci-sphere dot cloud + rotating arcs + mouse parallax.
---

<div class="globe-stage" id="globe-stage" aria-hidden="true">
  <div class="globe-halo"></div>
  <canvas id="globe-canvas"></canvas>

  <div class="chip chip-1">
    <span class="chip-dot"></span>
    <div>
      <div class="chip-title">Smart Devices Online</div>
      <div class="chip-value">2,400,000+</div>
    </div>
  </div>
  <div class="chip chip-2">
    <span class="chip-dot chip-dot-amber"></span>
    <div>
      <div class="chip-title">Countries &amp; Regions</div>
      <div class="chip-value">80+</div>
    </div>
  </div>
</div>

<script>
  const canvas = document.getElementById("globe-canvas");
  const stage = document.getElementById("globe-stage");

  if (canvas && stage) {
    const ctx = canvas.getContext("2d");
    const DPR = Math.min(window.devicePixelRatio || 1, 2);

    // ---- config ----
    const DOTS = 1400;          // surface particles
    const NODES = 14;           // bright hub nodes
    const ARCS = 7;             // connection arcs
    const FOV = 2.6;            // perspective depth
    const TILT_X = 0.32;        // base tilt (radians)
    const ROT_SPEED = 0.0022;   // auto rotation per frame
    const REDUCED = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let W = 0, H = 0, CX = 0, CY = 0, R = 0;

    // ---- fibonacci sphere ----
    const GA = Math.PI * (3 - Math.sqrt(5));
    const dots = [];
    for (let i = 0; i < DOTS; i++) {
      const y = 1 - (i / (DOTS - 1)) * 2;
      const rad = Math.sqrt(1 - y * y);
      const th = GA * i;
      dots.push({
        x: Math.cos(th) * rad,
        y,
        z: Math.sin(th) * rad,
        s: 0.6 + Math.random() * 0.9, // dot size factor
      });
    }

    // pick evenly spread nodes from the dots
    const nodes = [];
    const step = Math.floor(DOTS / NODES);
    for (let i = 0; i < NODES; i++) nodes.push(dots[i * step]);

    // ---- arcs between node pairs (great-circle with altitude hump) ----
    const pairs = [
      [0, 3], [1, 5], [2, 8], [4, 11], [6, 9], [7, 13], [10, 12],
    ].slice(0, ARCS);
    const arcs = pairs.map(([a, b], i) => ({
      a: nodes[a],
      b: nodes[b],
      t: Math.random(),            // pulse position 0..1
      speed: 0.0035 + Math.random() * 0.002,
      delay: i * 0.4,
    }));

    const slerp = (a, b, t, lift) => {
      let dot = a.x * b.x + a.y * b.y + a.z * b.z;
      dot = Math.min(1, Math.max(-1, dot));
      const th = Math.acos(dot);
      const sin = Math.sin(th) || 1e-6;
      const k1 = Math.sin((1 - t) * th) / sin;
      const k2 = Math.sin(t * th) / sin;
      const scale = 1 + lift * Math.sin(Math.PI * t);
      return {
        x: (a.x * k1 + b.x * k2) * scale,
        y: (a.y * k1 + b.y * k2) * scale,
        z: (a.z * k1 + b.z * k2) * scale,
      };
    };

    // ---- interaction ----
    let rotY = 0, rotX = TILT_X;
    let targetTilt = TILT_X;
    let pointerX = null;

    stage.addEventListener("pointermove", (e) => {
      const r = stage.getBoundingClientRect();
      pointerX = (e.clientX - r.left) / r.width - 0.5; // -0.5..0.5
      targetTilt = TILT_X + pointerX * 0.5;
    });
    stage.addEventListener("pointerleave", () => {
      pointerX = null;
      targetTilt = TILT_X;
    });

    const resize = () => {
      const size = Math.min(stage.clientWidth, 560);
      W = H = size;
      canvas.width = size * DPR;
      canvas.height = size * DPR;
      canvas.style.width = size + "px";
      canvas.style.height = size + "px";
      CX = CY = size / 2;
      R = size * 0.34;
    };
    resize();
    window.addEventListener("resize", resize);

    const project = (p) => {
      // rotate around Y
      const c = Math.cos(rotY), s = Math.sin(rotY);
      const x1 = p.x * c + p.z * s;
      const z1 = -p.x * s + p.z * c;
      // rotate around X
      const c2 = Math.cos(rotX), s2 = Math.sin(rotX);
      const y2 = p.y * c2 - z1 * s2;
      const z2 = p.y * s2 + z1 * c2;
      // perspective
      const scale = FOV / (FOV + z2);
      return { x: CX + x1 * R * scale, y: CY + y2 * R * scale, z: z2, scale };
    };

    const visible = () => {
      const r = canvas.getBoundingClientRect();
      return r.bottom > 0 && r.top < window.innerHeight;
    };

    const drawFrame = () => {
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      ctx.clearRect(0, 0, W, H);

      // atmosphere ring
      const atm = ctx.createRadialGradient(CX, CY, R * 0.7, CX, CY, R * 1.35);
      atm.addColorStop(0, "rgba(249,115,22,0)");
      atm.addColorStop(0.72, "rgba(249,115,22,0.10)");
      atm.addColorStop(0.86, "rgba(251,146,60,0.22)");
      atm.addColorStop(1, "rgba(251,146,60,0)");
      ctx.fillStyle = atm;
      ctx.beginPath();
      ctx.arc(CX, CY, R * 1.35, 0, Math.PI * 2);
      ctx.fill();

      // sphere base shading (front-facing soft disc)
      const disc = ctx.createRadialGradient(
        CX - R * 0.35, CY - R * 0.4, R * 0.1,
        CX, CY, R * 1.02
      );
      disc.addColorStop(0, "rgba(255,237,213,0.55)");
      disc.addColorStop(0.55, "rgba(254,215,170,0.28)");
      disc.addColorStop(1, "rgba(234,88,12,0.10)");
      ctx.fillStyle = disc;
      ctx.beginPath();
      ctx.arc(CX, CY, R * 1.0, 0, Math.PI * 2);
      ctx.fill();

      // particles: project + sort back-to-front
      const withRef = dots.map((d) => ({ d, p: project(d) }));
      withRef.sort((a, b) => b.p.z - a.p.z);
      for (const { d, p } of withRef) {
        const depth = (p.z + 1) / 2; // 0 back .. 1 front
        const alpha = 0.06 + depth * 0.5;
        const size = d.s * (0.7 + depth * 1.1);
        ctx.fillStyle =
          depth > 0.82
            ? `rgba(194,65,12,${alpha + 0.15})`
            : depth > 0.5
              ? `rgba(249,115,22,${alpha})`
              : `rgba(154,52,18,${alpha * 0.6})`;
        ctx.beginPath();
        ctx.arc(p.x, p.y, size, 0, Math.PI * 2);
        ctx.fill();
      }

      // hub nodes with glow (front side only)
      for (const n of nodes) {
        const p = project(n);
        if (p.z > 0.1) continue;
        const depth = (p.z + 1) / 2;
        const g = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, 10);
        g.addColorStop(0, "rgba(234,88,12,0.9)");
        g.addColorStop(0.4, "rgba(249,115,22,0.35)");
        g.addColorStop(1, "rgba(249,115,22,0)");
        ctx.fillStyle = g;
        ctx.beginPath();
        ctx.arc(p.x, p.y, 10, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = `rgba(154,52,18,${0.5 + depth * 0.5})`;
        ctx.beginPath();
        ctx.arc(p.x, p.y, 2.6, 0, Math.PI * 2);
        ctx.fill();
      }

      // arcs + travelling pulses
      for (const arc of arcs) {
        arc.t += arc.speed;
        if (arc.t > 1.4) arc.t = -0.4; // pause between runs

        const pa = project(arc.a), pb = project(arc.b);
        if (pa.z > 0.55 && pb.z > 0.55) continue; // both deep on back side

        ctx.beginPath();
        let started = false;
        for (let i = 0; i <= 48; i++) {
          const t = i / 48;
          const q = project(slerp(arc.a, arc.b, t, 0.28));
          if (!started) { ctx.moveTo(q.x, q.y); started = true; }
          else ctx.lineTo(q.x, q.y);
        }
        ctx.strokeStyle = "rgba(249,115,22,0.14)";
        ctx.lineWidth = 1;
        ctx.stroke();

        // pulse segment
        const t0 = Math.max(0, Math.min(1, arc.t - 0.08));
        const t1 = Math.max(0, Math.min(1, arc.t));
        if (t1 > t0 && arc.t >= 0 && arc.t <= 1) {
          const grad = ctx.createLinearGradient(pa.x, pa.y, pb.x, pb.y);
          grad.addColorStop(0, "rgba(251,191,36,0)");
          grad.addColorStop(0.5, "rgba(251,146,60,0.95)");
          grad.addColorStop(1, "rgba(251,191,36,0)");
          ctx.beginPath();
          let s2 = false;
          for (let i = 0; i <= 24; i++) {
            const t = t0 + ((t1 - t0) * i) / 24;
            const q = project(slerp(arc.a, arc.b, t, 0.28));
            if (!s2) { ctx.moveTo(q.x, q.y); s2 = true; }
            else ctx.lineTo(q.x, q.y);
          }
          ctx.strokeStyle = grad;
          ctx.lineWidth = 1.8;
          ctx.lineCap = "round";
          ctx.stroke();

          // pulse head
          const head = project(slerp(arc.a, arc.b, t1, 0.28));
          const hg = ctx.createRadialGradient(head.x, head.y, 0, head.x, head.y, 7);
          hg.addColorStop(0, "rgba(251,191,36,0.95)");
          hg.addColorStop(1, "rgba(251,191,36,0)");
          ctx.fillStyle = hg;
          ctx.beginPath();
          ctx.arc(head.x, head.y, 7, 0, Math.PI * 2);
          ctx.fill();
        }
      }
    };

    const tick = () => {
      if (visible()) {
        rotY += ROT_SPEED + (pointerX !== null ? pointerX * 0.004 : 0);
        // ease tilt toward target
        rotX += (targetTilt - rotX) * 0.06;
        drawFrame();
      }
      if (!REDUCED) requestAnimationFrame(tick);
    };

    if (REDUCED) {
      rotY = 0.6;
      drawFrame();
    } else {
      requestAnimationFrame(tick);
    }
  }
</script>

<style>
  .globe-stage {
    position: relative;
    width: 100%;
    max-width: 520px;
    margin-inline: auto;
    aspect-ratio: 1 / 1;
  }

  .globe-halo {
    position: absolute;
    inset: 6%;
    border-radius: 50%;
    background: radial-gradient(
      circle at 50% 42%,
      rgba(249, 115, 22, 0.16),
      rgba(251, 191, 36, 0.06) 55%,
      transparent 72%
    );
    filter: blur(18px);
  }

  #globe-canvas {
    position: relative;
    display: block;
    margin-inline: auto;
  }

  .chip {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(249, 115, 22, 0.15);
    border-radius: 14px;
    padding: 0.65rem 0.9rem;
    box-shadow: 0 10px 34px rgba(0, 0, 0, 0.08);
    animation: floaty 6s ease-in-out infinite;
  }
  .chip-1 { top: 8%; left: -4%; }
  .chip-2 { bottom: 6%; right: -2%; animation-delay: 1.4s; }
  @keyframes floaty {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-9px); }
  }

  .chip-dot {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: #22c55e;
    box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.18);
    flex: none;
  }
  .chip-dot-amber {
    background: #f97316;
    box-shadow: 0 0 0 4px rgba(249, 115, 22, 0.18);
  }
  .chip-title {
    font-size: 0.7rem;
    line-height: 1.1;
    color: #6b7280;
    white-space: nowrap;
  }
  .chip-value {
    font-size: 0.95rem;
    font-weight: 700;
    color: #1f2937;
    white-space: nowrap;
  }

  @media (max-width: 1023px) {
    .globe-stage { max-width: 400px; margin-top: 2.5rem; }
    .chip-1 { left: 0; }
    .chip-2 { right: 0; }
  }
</style>

    for (let i = 0; i < OCEAN_DOTS; i++) {
      const y = 1 - (i / (OCEAN_DOTS - 1)) * 2;
      const rad = Math.sqrt(1 - y * y);
      const th = GA * i;
      ocean.push({ x: Math.cos(th) * rad, y, z: Math.sin(th) * rad });
    }


    const landPts = [];
    {
      const n = LAND_RAW.split(" ");
      for (let i = 0; i < n.length; i += 2) {
        const lon = (parseInt(n[i], 10) / 10) * Math.PI / 180;
        const lat = (parseInt(n[i + 1], 10) / 10) * Math.PI / 180;
        const cl = Math.cos(lat);

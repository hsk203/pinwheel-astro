      const z1 = -p.x * s + p.z * c;
      const y2 = p.y * cT - z1 * sT;
      const z2 = p.y * sT + z1 * cT;
      const scale = FOV / (FOV + z2);
      return { x: CX + x1 * R * scale, y: CY + y2 * R * scale, z: z2 };
